# Tambahkan/padukan bagian ini ke .env root; jangan timpa konfigurasi DB/auth.
CCTV_1_URL='https://cctv.jogjaprov.go.id/cctv-proxy/cctv-uptmalioboro/streams/UPTMalio_NolKm_Timur.stream.m3u8'
CCTV_1_NAME='Nol Kilometer Timur'
CCTV_2_URL='https://cctv.jogjaprov.go.id/cctv-proxy/cctv-uptmalioboro/streams/UPTMalio_NolKmGedungAgung.stream.m3u8'
CCTV_2_NAME='Nol Kilometer Gedung Agung'

# Contoh RTSP (ganti IP/kredensial/path sesuai kamera, bukan alamat siap pakai):
# CCTV_1_URL='rtsp://USER:PASSWORD@192.0.2.10:554/stream1'
# CCTV_1_NAME='Gerbang Utama'
# CCTV_2_URL='rtsp://USER:PASSWORD@192.0.2.11:554/stream1'
# CCTV_2_NAME='Area Produksi'
# URL-encode karakter khusus username/password (@ menjadi %40, # menjadi %23).
# Quote tunggal menjaga $ dalam value tidak diinterpolasi Compose.

# Minimum jeda per kamera setelah inferensi selesai; bukan FPS stream asli.
CCTV_SAMPLE_SECONDS=2
CCTV_STALE_SECONDS=30
CCTV_RECONNECT_SECONDS=5
CCTV_TIMEOUT_SECONDS=10

# Kosong = preview objek saja. Isi nama profil vehicle.profiles di
# backend/app/ai/config.yaml HANYA setelah kalibrasi kamera/resolusi valid.
CCTV_1_VEHICLE_PROFILE=''
CCTV_2_VEHICLE_PROFILE=''
# Perubahan config.yaml/model logic perlu build demo-live sebelum recreate.

# Setelah mengubah .env, jalankan dari root project:
# docker compose up -d --no-deps --force-recreate demo-live raw-stream frontend
# docker compose restart saja TIDAK membaca ulang environment.
# Nama kamera di halaman diperbarui setelah reload browser.
# IP RTSP harus dapat dijangkau dari container (localhost berarti container).
# Ini mengubah viewer/inferensi demo, BUKAN config.yaml worker backend/DB/MediaMTX.
# Vehicle tetap object detection tanpa alarm sampai ada kalibrasi/integrasi rule.
# Keputusan rule terkonfirmasi disimpan dengan snapshot melalui outbox tahan restart.
DETECTION_PERSIST_ENABLED=true
# DETECTION_INGEST_TOKEN wajib berupa secret acak milik deployment (sudah dibuat di .env).
# Jangan mengganti dengan contoh/password akun demo. Backend dan demo-live harus sama.
# API backend dijalankan tanpa seed ulang dan AI_WORKERS_ENABLED=false;
# service demo-live menjadi satu-satunya sumber inferensi live untuk konfigurasi ini.
# Jika persistence dimatikan, gambar tetap jalan tetapi tidak membuat riwayat baru.
# .env berisi secret; jangan commit atau membagikan output docker compose config.

@using MvcSmartCctv.Models
@{
    var shell = ViewBag.Shell as ShellViewModel ?? new ShellViewModel();
    Func<string, bool> isActive = key => shell.Active == key;
    Func<string, string> initials = name => {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ');
        var sb = new System.Text.StringBuilder();
        foreach (var p in parts) { if (p.Length > 0 && sb.Length < 2) sb.Append(char.ToUpper(p[0])); }
        return sb.ToString();
    };
}
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewBag.Title — Smart CCTV AI</title>
<link rel="icon" href="@Url.Content("~/Content/pertamina-ep-logo.jpg")" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap">
<link rel="stylesheet" href="@Url.Content("~/Content/styles.css")" />
@RenderSection("Styles", required: false)
</head>
<body>
<header>
  <div id="shell-header">
    <div class="brand">
      <img src="@Url.Content("~/Content/pertamina-ep-logo.jpg")" alt="Pertamina EP" />
      <div class="divider"></div>
      <div>
        <h1>Smart CCTV AI</h1>
        <div class="sub">Safety &amp; Vehicle Violation Detection</div>
      </div>
    </div>
    <div class="header-right">
      <span class="portal-pill@(shell.RoleLabel == "Admin" ? " admin" : "")">@shell.RoleLabel</span>
      <div class="user-chip">
        <div class="avatar">@initials(shell.UserName)</div>
        <span class="name">@shell.UserName</span>
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { style = "display:inline;" }))
        {
          <button type="submit" class="logout-btn">Keluar</button>
        }
      </div>
    </div>
  </div>
</header>
<div class="app-layout">
  <nav class="sidebar">
    <div class="nav-group-label">Overview</div>
    <a class="nav-item@(isActive("dashboard") ? " active" : "")" href="@Url.Action("Index", "Home")">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
      <span>Dashboard</span>
    </a>
    <div class="nav-group-label">Deteksi</div>
    <a class="nav-item@(isActive("apd") ? " active" : "")" href="@Url.Action("Index", "Apd")">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 15.5V15a8 8 0 0 1 16 0v0.5"/><rect x="3" y="15.5" width="18" height="3" rx="1.2"/><path d="M12 6.5v2.2"/></svg>
      <span>APD Detection</span>
    </a>
    <a class="nav-item@(isActive("vehicle") ? " active" : "")" href="@Url.Action("Index", "Vehicle")">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="6" width="11" height="10" rx="1"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
      <span>Vehicle Violation</span>
    </a>
    <div class="nav-group-label">Operasional</div>
    <a class="nav-item@(isActive("cases") ? " active" : "")" href="@Url.Action("Index", "Cases")">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1z"/><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 12.5l2 2 4-4.5"/></svg>
      <span>Case Violation</span>
    </a>
    <a class="nav-item@(isActive("reports") ? " active" : "")" href="@Url.Action("Index", "Reports")">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 19V11"/><path d="M10 19V5"/><path d="M16 19v-7"/><path d="M4 19h16"/></svg>
      <span>Laporan &amp; Analitik</span>
    </a>
    @if (shell.IsAdmin)
    {
      <div class="nav-group-label">Platform</div>
      <a class="nav-item@(isActive("settings") ? " active" : "")" href="@Url.Action("Index", "Settings")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="6" x2="20" y2="6"/><circle cx="9" cy="6" r="1.8" fill="#fff"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="15" cy="12" r="1.8" fill="#fff"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="7" cy="18" r="1.8" fill="#fff"/></svg>
        <span>Pengaturan</span>
      </a>
      <a class="nav-item@(isActive("admin") ? " active" : "")" href="@Url.Action("Index", "Admin")">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Manajemen User</span>
      </a>
    }
  </nav>
  <main>
    @RenderBody()
  </main>
</div>
@RenderSection("Scripts", required: false)
</body>
</html>
